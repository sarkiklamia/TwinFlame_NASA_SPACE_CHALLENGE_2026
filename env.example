# ============================================================
# TwinFlame - Environment Configuration
# Copy .env.example to .env and fill in the secrets.
# NEVER commit .env
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

APP_NAME=TwinFlame
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# BACKEND API (FastAPI)
# ============================================================

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of origins allowed to call the API (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================
# FRONTEND (React)
# Vite only exposes variables prefixed with VITE_.
# Put these in app/frontend/.env as well (Vite reads its own folder).
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:8000

# Dashboard refresh interval (seconds)
VITE_REFRESH_SECONDS=60


# ============================================================
# DATA LOCATIONS
# Relative paths are resolved from the project root.
# ============================================================

RAW_DATA_DIR=data/raw
VALIDATED_DIR=data/processed/validated
CLEANED_DIR=data/processed/cleaned
STANDARDIZED_DIR=data/processed/standardized
HARMONIZATION_DIR=data/harmonization
LOG_DIR=logs


# ============================================================
# DUCKDB CONFIGURATION
# ============================================================

DUCKDB_PATH=database/twinflame.duckdb

# The API must NEVER write to the database. Ingestion/processing code
# opens its own connection with read_only=False explicitly.
DUCKDB_READ_ONLY=true

# Spill directory for large queries
DUCKDB_TEMP_DIR=database/tmp_spill

# Number of threads DuckDB can use
DUCKDB_THREADS=4


# ============================================================
# NASA FIRMS API
# Used only by the ingestion pipeline.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# ============================================================

FIRMS_MAP_KEY=your_firms_map_key_here


# ============================================================
# API REQUEST BEHAVIOUR
# ============================================================

# Seconds before a request times out
API_TIMEOUT=30

# Retries per failed request
API_MAX_RETRIES=3

# Base delay between retries (seconds)
API_RETRY_DELAY=5


# ============================================================
# DATA PROCESSING
# ============================================================

# Maximum number of records per processing batch
BATCH_SIZE=100000

# Output format for processed datasets
OUTPUT_FORMAT=parquet


# ============================================================
# VALIDATION
# ============================================================

VALIDATE_COORDINATES=true
VALIDATE_REQUIRED_COLUMNS=true
