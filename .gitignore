# ============================================================
# TwinFlame - Git Ignore
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example
.envrc
.secrets/

# Machine-specific public root CA used only as a Docker BuildKit secret.
docker/certs/*.crt

# Python bytecode and interpreter artifacts
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/

# Share only the reusable Phase 05 instructions and empty label templates.
# Generated review queues, manifests, and all other run data stay local.
!data/validation/README.md
!data/validation/candidate_recall_reference_pairs.csv
!data/validation/activity_reference_labels.csv
ENV/
env/
.direnv/

# Python testing, linting, and type-checking
.cache/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
*.py,cover
coverage.xml
pytestdebug.log
coverage/
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints/

# Frontend (React)
node_modules/
app/frontend/dist/
app/frontend/build/
app/frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs
*.log
logs/

# Generated satellite data.
# Ignore all generated and downloaded data; keep only folder skeletons (.gitkeep).
data/**
!data/**/
!data/**/.gitkeep

# Local pipeline and calibration outputs accidentally written at repository root.
# Source code and documentation remain trackable.
/july_2026_*.csv
/phase03_candidate_counts_*.csv
/phase04a_screening_*.csv
*.parquet
.pytest-tmp-*/

# Local databases and DuckDB spill files (schema.sql stays tracked)
database/*.duckdb
database/*.db
database/*.wal
database/*.sqlite
database/*.sqlite3
database/**/*.duckdb
database/**/*.db
database/**/*.wal
database/**/*.sqlite
database/**/*.sqlite3
database/tmp_spill/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*.orig

# Build and distribution
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
wheelhouse/

# Local-only configuration (do not use for shareable project configuration)
*.local


# All CSV files
*.csv
# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/

# Allow the reusable validation instructions and empty input templates only.
# The generated review queue and all other run data remain ignored.
!data/validation/README.md
!data/validation/candidate_recall_reference_pairs.csv
!data/validation/activity_reference_labels.csv

# CSV files
*.csv

# Local data
data/