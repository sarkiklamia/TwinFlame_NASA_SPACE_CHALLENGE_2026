# ============================================================
# TwinFlame - Git Ignore
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example
.envrc
.secrets/

# Python bytecode and interpreter artifacts
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
.direnv/

# Python testing, linting, and type-checking
.cache/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
*.py,cover
coverage.xml
pytestdebug.log
coverage/
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints/

# Frontend (React)
node_modules/
app/frontend/dist/
app/frontend/build/
app/frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs
*.log
logs/

# Generated satellite data.
# Ignore all generated and downloaded data; keep only folder skeletons (.gitkeep).
data/**
!data/**/
!data/**/.gitkeep

# Local databases and DuckDB spill files (schema.sql stays tracked)
database/*.duckdb
database/*.db
database/*.wal
database/*.sqlite
database/*.sqlite3
database/**/*.duckdb
database/**/*.db
database/**/*.wal
database/**/*.sqlite
database/**/*.sqlite3
database/tmp_spill/
database/auth_sessions.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*.orig

# Build and distribution
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
wheelhouse/

# Local-only configuration (do not use for shareable project configuration)
*.local
